{
  "name": "7sanat-afyon-mobil",
  "version": "1.0.0",
  "private": true,
  "description": "7Sanat Afyon — iOS ve Android uygulaması (Capacitor)",
  "scripts": {
    "web": "node scripts/web-hazirla.js",
    "ikonlar": "capacitor-assets generate --iconBackgroundColor '#0a0a0a' --iconBackgroundColorDark '#0a0a0a' --splashBackgroundColor '#0a0a0a' --splashBackgroundColorDark '#0a0a0a'",
    "senkron": "npm run web && npx cap sync",
    "android": "npm run senkron && npx cap open android",
    "ios": "npm run senkron && npx cap open ios",
    "apk": "npm run senkron && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "tailwindcss": "^3.4.17"
  }
}
